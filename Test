        // --- LIGHTING SETUP ---
        function setupLighting() {
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
            scene.add(ambientLight);

            const mainLight = new THREE.DirectionalLight(0xffffff, 1.3);
            mainLight.position.set(8, 14, 6);
            mainLight.castShadow = true;
            mainLight.shadow.mapSize.width = 2048;
            mainLight.shadow.mapSize.height = 2048;
            mainLight.shadow.camera.near = 0.5;
            mainLight.shadow.camera.far = 25;
            const d = 6;
            mainLight.shadow.camera.left = -d;
            mainLight.shadow.camera.right = d;
            mainLight.shadow.camera.top = d;
            mainLight.shadow.camera.bottom = -d;
            mainLight.shadow.bias = -0.0005;
            scene.add(mainLight);

            const fillLight = new THREE.DirectionalLight(0x38bdf8, 0.4);
            fillLight.position.set(-6, 4, -6);
            scene.add(fillLight);

            const warmRim = new THREE.PointLight(0xf59e0b, 0.8, 12);
            warmRim.position.set(2, 2, -4);
            scene.add(warmRim);
        }

        // --- ENVIRONMENT SETUP ---
        function setupEnvironment() {
            const gridHelper = new THREE.GridHelper(20, 20, 0x334155, 0x1e293b);
            gridHelper.position.y = -2.2;
            scene.add(gridHelper);

            const shadowPlaneGeo = new THREE.PlaneGeometry(30, 30);
            const shadowPlaneMat = new THREE.ShadowMaterial({ opacity: 0.35 });
            const shadowPlane = new THREE.Mesh(shadowPlaneGeo, shadowPlaneMat);
            shadowPlane.rotation.x = -Math.PI / 2;
            shadowPlane.position.y = -2.21;
            shadowPlane.receiveShadow = true;
            scene.add(shadowPlane);
        }

        // --- PROCEDURAL GEOMETRY BUILDERS ---
        function createCorrugatedDeckGeometry(width, length, pitch, height) {
            const shape = new THREE.Shape();
            const repeats = Math.floor(length / pitch);
            const startX = -length / 2;

            shape.moveTo(startX, 0);
            for (let i = 0; i < repeats; i++) {
                const x = startX + i * pitch;
                shape.lineTo(x + pitch * 0.2, 0);
                shape.lineTo(x + pitch * 0.35, height);
                shape.lineTo(x + pitch * 0.65, height);
                shape.lineTo(x + pitch * 0.8, 0);
                shape.lineTo(x + pitch, 0);
            }

            const geo = new THREE.ExtrudeGeometry(shape, { steps: 1, depth: width, bevelEnabled: false });
            geo.center();
            geo.rotateY(Math.PI / 2);
            return geo;
        }

        // --- BUILD MODEL LAYERS ---
        function buildRoofModel() {
            const width = 4.0;
            const length = 4.0;

            ROOF_LAYERS.forEach((data, index) => {
                let mesh;

                if (data.type === 'deck') {
                    const geo = createCorrugatedDeckGeometry(width, length, 0.5, 0.22);
                    const mat = new THREE.MeshStandardMaterial({
                        color: data.color,
                        metalness: 0.8,
                        roughness: 0.3,
                        side: THREE.DoubleSide
                    });
                    mesh = new THREE.Mesh(geo, mat);
                } else if (data.type === 'parapet') {
                    const group = new THREE.Group();

                    // Masonry Block Wall
                    const wallGeo = new THREE.BoxGeometry(0.5, 1.4, length + 0.5);
                    const wallMat = new THREE.MeshStandardMaterial({ color: 0x475569, roughness: 0.9 });
                    const wall = new THREE.Mesh(wallGeo, wallMat);
                    wall.position.set(-width / 2 - 0.25, 0.3, 0.25);
                    group.add(wall);

                    // Metal Coping Cap
                    const capGeo = new THREE.BoxGeometry(0.65, 0.1, length + 0.6);
                    const capMat = new THREE.MeshStandardMaterial({ color: 0x334155, metalness: 0.7, roughness: 0.3 });
                    const cap = new THREE.Mesh(capGeo, capMat);
                    cap.position.set(-width / 2 - 0.25, 1.05, 0.25);
                    group.add(cap);

                    // Termination Counter-Flashing Bar
                    const flashGeo = new THREE.BoxGeometry(0.08, 0.25, length);
                    const flashMat = new THREE.MeshStandardMaterial({ color: 0x94a3b8, metalness: 0.6, roughness: 0.4 });
                    const flash = new THREE.Mesh(flashGeo, flashMat);
                    flash.position.set(-width / 2 + 0.04, 0.4, 0);
                    group.add(flash);

                    mesh = group;
                } else if (data.type === 'staggered_board') {
                    // Polyiso Insulation constructed as dual boards with staggered offset seam
                    const group = new THREE.Group();
                    const subMat = new THREE.MeshStandardMaterial({ color: data.color, roughness: 0.85 });

                    const layer1 = new THREE.Mesh(new THREE.BoxGeometry(width, data.thickness / 2, length), subMat);
                    layer1.position.y = -data.thickness / 4;

                    const layer2 = new THREE.Mesh(new THREE.BoxGeometry(width, data.thickness / 2, length), subMat);
                    layer2.position.y = data.thickness / 4;
                    group.add(layer1, layer2);

                    mesh = group;
                } else if (data.id === 'membrane') {
                    // TPO Membrane with raised heat-welded seam details
                    const group = new THREE.Group();
                    const mainMat = new THREE.MeshStandardMaterial({ color: data.color, roughness: 0.25 });
                    const baseMesh = new THREE.Mesh(new THREE.BoxGeometry(width, data.thickness, length), mainMat);
                    group.add(baseMesh);

                    // Weld Seams lines
                    const seamMat = new THREE.MeshStandardMaterial({ color: 0xcff4fc, roughness: 0.3 });
                    for (let z = -length / 2 + 1; z < length / 2; z += 1.33) {
                        const seam = new THREE.Mesh(new THREE.BoxGeometry(width, 0.02, 0.06), seamMat);
                        seam.position.set(0, data.thickness / 2 + 0.01, z);
                        group.add(seam);
                    }
                    mesh = group;
                } else {
                    const geo = new THREE.BoxGeometry(width, data.thickness, length);
                    const mat = new THREE.MeshStandardMaterial({
                        color: data.color,
                        roughness: data.id === 'vapor' ? 0.8 : 0.5,
                        metalness: data.id === 'vapor' ? 0.2 : 0.1
                    });
                    mesh = new THREE.Mesh(geo, mat);
                }

                // Enable shadows
                mesh.traverse(child => {
                    if (child.isMesh) {
                        child.castShadow = true;
                        child.receiveShadow = true;
                    }
                });

                const assembledY = data.heightOffset;
                const explodedY = data.heightOffset * EXP_FACTOR;

                mesh.position.set(0, assembledY, 0);
                mesh.userData = {
                    id: data.id,
                    index: index,
                    assembledY: assembledY,
                    explodedY: explodedY,
                    data: data
                };

                meshGroup.add(mesh);
                layerMeshes.push(mesh);

                // Create HTML 3D Hotspot Pin
                createHotspot(mesh, data);
            });
        }

        // --- HOTSPOTS CREATION ---
        function createHotspot(mesh, data) {
            const container = document.getElementById('hotspots-container');
            const pin = document.createElement('button');
            pin.className = 'hotspot-pin absolute pointer-events-auto flex items-center justify-center w-7 h-7 rounded-full bg-slate-900/90 text-amber-400 border border-amber-500/50 shadow-lg font-bold text-xs hover:bg-amber-500 hover:text-slate-950 transition-all';
            pin.innerHTML = `<span>${ROOF_LAYERS.length - ROOF_LAYERS.indexOf(data)}</span>`;
            pin.dataset.id = data.id;

            pin.addEventListener('click', (e) => {
                e.stopPropagation();
                selectLayer(data.id);
            });

            container.appendChild(pin);

            hotspots.push({
                element: pin,
                mesh: mesh,
                id: data.id
            });
        }

        // --- UPDATE SCREEN-SPACE HOTSPOTS ---
        function updateHotspots() {
            const tempV = new THREE.Vector3();

            hotspots.forEach(hotspot => {
                if (isIsolated && hotspot.id !== selectedLayerId) {
                    hotspot.element.style.display = 'none';
                    return;
                }

                hotspot.mesh.getWorldPosition(tempV);
                
                if (hotspot.id === 'parapet') {
                    tempV.x += -1.8;
                    tempV.y += 0.8;
                } else {
                    tempV.x += 1.5;
                    tempV.z += 1.5;
                }

                tempV.project(camera);

                if (tempV.z > 1) {
                    hotspot.element.style.display = 'none';
                    return;
                }

                const x = (tempV.x * .5 + .5) * window.innerWidth;
                const y = (-(tempV.y * .5) + .5) * window.innerHeight;

                hotspot.element.style.left = `${x}px`;
                hotspot.element.style.top = `${y}px`;
                hotspot.element.style.display = 'flex';
            });
        }

        // --- UI BUILDER ---
        function buildLayerUI() {
            const container = document.getElementById('layer-list-container');
            container.innerHTML = '';

            ROOF_LAYERS.forEach((data, idx) => {
                const btn = document.createElement('button');
                btn.className = `layer-btn w-full flex items-center justify-between p-2.5 rounded-xl border text-left transition-all text-xs font-medium ${
                    selectedLayerId === data.id
                        ? 'bg-amber-500/15 border-amber-500/60 text-amber-300'
                        : 'bg-slate-900/40 border-slate-800/80 text-slate-300 hover:bg-slate-800/60 hover:text-white'
                }`;
                btn.dataset.id = data.id;

                btn.innerHTML = `
                    <div class="flex items-center space-x-2.5 truncate">
                        <span class="w-5 h-5 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center text-[10px] font-bold text-slate-400 shrink-0">
                            ${ROOF_LAYERS.length - idx}
                        </span>
                        <span class="truncate">${data.shortName}</span>
                    </div>
                    <i class="fa-solid fa-chevron-right text-[10px] opacity-40"></i>
                `;

                btn.addEventListener('click', () => selectLayer(data.id));
                container.appendChild(btn);
            });
        }

        // --- SELECTION & INSPECTION LOGIC ---
        function selectLayer(id) {
            selectedLayerId = id;
            const data = ROOF_LAYERS.find(l => l.id === id);
            const targetMesh = layerMeshes.find(m => m.userData.id === id);

            if (!data || !targetMesh) return;

            const isolateBtn = document.getElementById('btn-isolate');
            isolateBtn.removeAttribute('disabled');
            isolateBtn.classList.remove('opacity-50', 'cursor-not-allowed');

            layerMeshes.forEach(mesh => {
                const isSelected = mesh.userData.id === id;
                mesh.traverse(child => {
                    if (child.isMesh && child.material) {
                        if (isSelected) {
                            child.material.emissive = new THREE.Color(0xf59e0b);
                            child.material.emissiveIntensity = 0.25;
                        } else {
                            child.material.emissive = new THREE.Color(0x000000);
                            child.material.emissiveIntensity = 0;
                        }
                    }
                });
            });

            const worldPos = new THREE.Vector3();
            targetMesh.getWorldPosition(worldPos);

            gsap.to(controls.target, {
                x: worldPos.x * 0.3,
                y: worldPos.y,
                z: worldPos.z * 0.3,
                duration: 0.7,
                ease: "power2.out"
            });

            document.querySelectorAll('.layer-btn').forEach(btn => {
                if (btn.dataset.id === id) {
                    btn.className = 'layer-btn w-full flex items-center justify-between p-2.5 rounded-xl border text-left transition-all text-xs font-medium bg-amber-500/20 border-amber-500/60 text-amber-300 shadow-md';
                } else {
                    btn.className = 'layer-btn w-full flex items-center justify-between p-2.5 rounded-xl border text-left transition-all text-xs font-medium bg-slate-900/40 border-slate-800/80 text-slate-300 hover:bg-slate-800/60 hover:text-white';
                }
            });

            document.getElementById('info-placeholder').classList.add('hidden');
            const infoContent = document.getElementById('info-content');
            infoContent.classList.remove('hidden');

            document.getElementById('layer-badge').innerText = data.badge;
            document.getElementById('layer-title').innerText = data.name;
            document.getElementById('layer-desc').innerText = data.desc;
            document.getElementById('layer-function').innerText = data.function;
            document.getElementById('layer-installation').innerText = data.installation;

            const specsGrid = document.getElementById('layer-specs');
            specsGrid.innerHTML = '';
            Object.entries(data.specs).forEach(([key, val]) => {
                const specItem = document.createElement('div');
                specItem.className = 'bg-slate-950/60 p-2 rounded-lg border border-slate-800/60';
                specItem.innerHTML = `
                    <span class="text-[10px] text-slate-400 block">${key}</span>
                    <span class="font-semibold text-slate-200 text-xs">${val}</span>
                `;
                specsGrid.appendChild(specItem);
            });

            document.getElementById('side-panel').classList.remove('translate-x-full');
        }

        // --- EXPLODE ANIMATION ---
        function toggleExplodedView() {
            isExploded = !isExploded;
            document.getElementById('explode-text').innerText = isExploded ? 'Stack Layers' : 'Explode Layers';

            layerMeshes.forEach(mesh => {
                const targetY = isExploded ? mesh.userData.explodedY : mesh.userData.assembledY;
                gsap.to(mesh.position, {
                    y: targetY,
                    duration: 0.8,
                    ease: "back.out(1.2)"
                });
            });
        }

        // --- RESET CAMERA ---
        function resetCamera() {
            gsap.to(camera.position, { x: 6.5, y: 5.0, z: 8.0, duration: 0.8, ease: "power2.out" });
            gsap.to(controls.target, { x: 0, y: 0, z: 0, duration: 0.8, ease: "power2.out" });

            if (isIsolated) {
                toggleIsolate();
            }
        }

        // --- TOGGLE WIREFRAME ---
        function toggleWireframe() {
            isWireframe = !isWireframe;
            const btn = document.getElementById('btn-wireframe');
            btn.classList.toggle('text-amber-400', isWireframe);
            btn.classList.toggle('bg-amber-500/20', isWireframe);

            layerMeshes.forEach(mesh => {
                mesh.traverse(child => {
                    if (child.isMesh && child.material) {
                        child.material.wireframe = isWireframe;
                    }
                });
            });
        }

        // --- TOGGLE ISOLATION MODE ---
        function toggleIsolate() {
            if (!selectedLayerId) return;

            isIsolated = !isIsolated;
            const btn = document.getElementById('btn-isolate');
            btn.classList.toggle('text-amber-400', isIsolated);
            btn.classList.toggle('bg-amber-500/20', isIsolated);

            layerMeshes.forEach(mesh => {
                const isSelected = mesh.userData.id === selectedLayerId;
                const targetScale = isIsolated ? (isSelected ? { x: 1, y: 1, z: 1 } : { x: 0.001, y: 0.001, z: 0.001 }) : { x: 1, y: 1, z: 1 };

                gsap.to(mesh.scale, {
                    x: targetScale.x,
                    y: targetScale.y,
                    z: targetScale.z,
                    duration: 0.4,
                    ease: "power2.out",
                    onUpdate: () => {
                        mesh.visible = mesh.scale.x > 0.01;
                    }
                });
            });
        }

        // --- TOGGLE HOTSPOTS VISIBILITY ---
        function toggleHotspotsVisibility() {
            const container = document.getElementById('hotspots-container');
            const btn = document.getElementById('btn-toggle-hotspots');
            
            const isHidden = container.style.display === 'none';
            container.style.display = isHidden ? 'block' : 'none';

            btn.classList.toggle('text-amber-400', isHidden);
            btn.classList.toggle('bg-amber-500/10', isHidden);
            btn.classList.toggle('text-slate-400', !isHidden);
        }

        // --- TOAST NOTIFICATION ---
        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').innerText = message;
            toast.classList.remove('opacity-0', '-translate-y-2');
            toast.classList.add('opacity-100', 'translate-y-0');

            setTimeout(() => {
                toast.classList.remove('opacity-100', 'translate-y-0');
                toast.classList.add('opacity-0', '-translate-y-2');
            }, 3000);
        }

        // --- EXPORT SNAPSHOT ---
        function exportSnapshot() {
            // Force re-render to ensure pristine frame buffer
            renderer.render(scene, camera);
            const dataUrl = renderer.domElement.toDataURL('image/png');

            const link = document.createElement('a');
            const timestamp = new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19);
            link.download = `Roof_Detail_Snapshot_${timestamp}.png`;
            link.href = dataUrl;
            link.click();

            showToast('High-Res PNG Snapshot downloaded!');
        }

        // --- SHARE LINK & ENCODE STATE ---
        function shareStateLink() {
            const params = new URLSearchParams();
            if (selectedLayerId) params.set('layer', selectedLayerId);
            if (isExploded) params.set('exploded', '1');
            if (isWireframe) params.set('wireframe', '1');
            if (isIsolated) params.set('isolated', '1');

            // Encode camera position & control target coordinates
            params.set('cx', camera.position.x.toFixed(2));
            params.set('cy', camera.position.y.toFixed(2));
            params.set('cz', camera.position.z.toFixed(2));
            params.set('tx', controls.target.x.toFixed(2));
            params.set('ty', controls.target.y.toFixed(2));
            params.set('tz', controls.target.z.toFixed(2));

            const shareUrl = `${window.location.origin}${window.location.pathname}?${params.toString()}`;

            // Exec command fallback for iframe compatibility
            const tempInput = document.createElement('input');
            document.body.appendChild(tempInput);
            tempInput.value = shareUrl;
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);

            showToast('Shareable view link copied to clipboard!');
        }

        // --- LOAD STATE FROM URL PARAMETERS ---
        function loadStateFromURL() {
            const params = new URLSearchParams(window.location.search);

            // Set camera & target position if supplied
            if (params.has('cx') && params.has('cy') && params.has('cz')) {
                camera.position.set(
                    parseFloat(params.get('cx')),
                    parseFloat(params.get('cy')),
                    parseFloat(params.get('cz'))
                );
            }

            if (params.has('tx') && params.has('ty') && params.has('tz')) {
                controls.target.set(
                    parseFloat(params.get('tx')),
                    parseFloat(params.get('ty')),
                    parseFloat(params.get('tz'))
                );
            }

            // Exploded State
            if (params.get('exploded') === '1') {
                toggleExplodedView();
            }

            // Wireframe State
            if (params.get('wireframe') === '1') {
                toggleWireframe();
            }

            // Active Layer
            const layerId = params.get('layer');
            if (layerId && ROOF_LAYERS.some(l => l.id === layerId)) {
                selectLayer(layerId);
                // Isolated view mode
                if (params.get('isolated') === '1') {
                    toggleIsolate();
                }
            }
        }

        // --- RAYCASTING FOR MOUSE SELECTION ---
        const raycaster = new THREE.Raycaster();
        const mouse = new THREE.Vector2();

        function onPointerDown(event) {
            if (event.target.tagName !== 'CANVAS') return;

            const rect = renderer.domElement.getBoundingClientRect();
            mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
            mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;

            raycaster.setFromCamera(mouse, camera);
            
            const clickableObjects = [];
            layerMeshes.forEach(m => {
                if (m.visible) {
                    if (m.isMesh) clickableObjects.push(m);
                    else m.traverse(c => { if (c.isMesh) clickableObjects.push(c); });
                }
            });

            const intersects = raycaster.intersectObjects(clickableObjects, false);

            if (intersects.length > 0) {
                let hitObj = intersects[0].object;
                while (hitObj.parent && !hitObj.userData.id && hitObj.parent !== scene) {
                    hitObj = hitObj.parent;
                }
                if (hitObj.userData && hitObj.userData.id) {
                    selectLayer(hitObj.userData.id);
                }
            }
        }

        // --- RESIZE HANDLER ---
        function onWindowResize() {
            const container = document.getElementById('canvas-container');
            camera.aspect = container.clientWidth / container.clientHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(container.clientWidth, container.clientHeight);
        }

        // --- ANIMATION LOOP ---
        function animate() {
            requestAnimationFrame(animate);
            controls.update();
            updateHotspots();
            renderer.render(scene, camera);
        }

        // Initialize on window load
        window.onload = init;
    </script>
</body>
</html>
